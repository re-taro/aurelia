---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

import * as styles from './styles.css';

type Props = {
	src: ImageMetadata | string;
	alt: string;
	title?: string;
};

const { src, alt, title } = Astro.props;
---

{typeof src !== 'string' ? (
	<Image
		src={src}
		widths={[640, 750, 828, 960, 1080, 1280, 1668, 1920, 2048, 2560, 3200, 3840, 4480, 5120, 6016]}
		sizes="auto, (min-width: 560px) 50vw, 100vw"
		alt={alt}
		title={title}
		class={styles.img}
	/>
) : (
	<Image inferSize src={src} alt={alt} title={title} class={styles.img} />
)}
