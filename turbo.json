{
	"$schema": "node_modules/turbo/schema.json",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["**/dist/**"]
		},
		"format": {
			"cache": false
		},
		"format:check": {},
		"lint:script": {
			"dependsOn": ["^build"]
		},
		"test:unit": {
			"dependsOn": ["^build"]
		},
		"typecheck": {
			"dependsOn": ["^build"]
		}
	}
}
