{
	"name": "@aurelia/framework",
	"version": "0.0.0",
	"type": "module",
	"private": true,
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		},
		"./entries": {
			"types": "./dist/entry-definition.d.mts",
			"import": "./dist/entry-definition.mjs"
		},
		"./server": {
			"types": "./dist/entries/server.d.mts",
			"import": "./dist/entries/server.mjs"
		},
		"./entries/*": "./dist/entries/*.mjs"
	},
	"imports": {
		"#rsc-client": {
			"types": "./src/entries/rsc-client.ts",
			"default": "./dist/entries/rsc-client.mjs"
		}
	},
	"files": [
		"dist",
		"src"
	],
	"scripts": {
		"build": "tsdown",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint:script": "eslint .",
		"test:unit": "vitest run",
		"test:e2e": "playwright test --config e2e/playwright.config.ts",
		"test:e2e:dev": "playwright test --config e2e/playwright-dev.config.ts",
		"typecheck": "tsc -p . --noEmit"
	},
	"peerDependencies": {
		"react": "^19.2.3",
		"react-dom": "^19.2.3",
		"vite": "^8.0.0"
	},
	"dependencies": {
		"@vitejs/plugin-rsc": "^0.5.25",
		"react-error-boundary": "^6.1.1",
		"rsc-html-stream": "^0.0.7",
		"srvx": "^0.11.15",
		"tiny-invariant": "^1.3.3"
	},
	"devDependencies": {
		"@playwright/test": "1.59.1",
		"@types/react": "19.2.8",
		"@types/react-dom": "19.2.3",
		"playwright": "1.59.1",
		"react": "19.2.3",
		"react-dom": "19.2.3",
		"serve": "14.2.6",
		"tsconfig": "workspace:*",
		"vite": "8.0.10"
	}
}
