{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-08-29",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "aurelia",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"routes": [
		{
			"pattern": "blog.re-taro.dev",
			"custom_domain": true,
		},
	],
	// 本番はカスタムドメインのみで配信する。PR プレビューは preview URL (pr-<番号>-aurelia.<subdomain>.workers.dev) を使う
	"workers_dev": false,
	"preview_urls": true,
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
	},
	"images": {
		"binding": "IMAGES",
	},
	"observability": {
		"enabled": true,
	},
}
